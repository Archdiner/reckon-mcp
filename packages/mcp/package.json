{
  "name": "@reckon/mcp",
  "version": "0.5.0",
  "description": "Reckon v5 MCP host: the Claude Code server + ClaudeCliBackend, wiring @reckon/core to the user's subscription via `claude -p`.",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "reckon-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@reckon/core": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
